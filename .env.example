# Aplicação (runtime / Vercel)
# Em produção, prefira a URL pooled fornecida pelo seu provedor PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mercadinho_sf

# Opcional: URL direta, sem pooler, usada apenas por migrations e seed.
# Se ausente, os scripts usam DATABASE_URL.
DATABASE_DIRECT_URL=

# Obrigatório em produção. Gere um segredo aleatório com pelo menos 32 caracteres.
AUTH_SECRET=troque-por-uma-chave-longa-com-pelo-menos-32-caracteres

# Usado somente ao executar npm run db:seed.
SEED_ADMIN_EMAIL=admin@mercadinho.local
SEED_ADMIN_PASSWORD=troque-esta-senha

OPEN_FOOD_FACTS_USER_AGENT=MercadinhoSaoFrancisco/0.1 (contato@seudominio.com)

# Variáveis usadas apenas pelo docker-compose local.
POSTGRES_DB=mercadinho_sf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres