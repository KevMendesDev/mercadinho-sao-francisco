# Banco interno do Docker
POSTGRES_DB=mercadinho_sf
POSTGRES_USER=mercadinho
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Use o hostname "postgres", que é o nome do serviço no Compose.
# Se a senha tiver caracteres especiais de URL, faça URL-encode nela.
DATABASE_URL=postgresql://mercadinho:troque-por-uma-senha-forte@postgres:5432/mercadinho_sf
DATABASE_DIRECT_URL=postgresql://mercadinho:troque-por-uma-senha-forte@postgres:5432/mercadinho_sf

AUTH_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
OPEN_FOOD_FACTS_USER_AGENT=MercadinhoSaoFrancisco/1.0 (contato@seudominio.com)

# Token criado no dashboard Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=troque-pelo-token-do-tunnel
